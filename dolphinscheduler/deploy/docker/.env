ENABLE_PUSH_IMAGE=false
HUB=reg.local:5000
TAG=latest
SERVICE_HOME=/product/services/dams

TZ=Asia/Shanghai
SPRING_JACKSON_TIME_ZONE=Asia/Shanghai

DATABASE=postgresql
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_DATASOURCE_URL="jdbc:postgresql://192.168.0.202:25432/dam?currentSchema=public&tcpKeepAlive=true&reWriteBatchedInserts=true&ApplicationName=dol_server&ssl=false"
SPRING_DATASOURCE_USERNAME=gaussdb
SPRING_DATASOURCE_PASSWORD=Gauss@123

REGISTRY_TYPE=zookeeper
REGISTRY_ZOOKEEPER_CONNECT_STRING=zookeeper:2181

SECURITY_AUTHENTICATION_TYPE=DAM
SECURITY_AUTHENTICATION_DAM_BASE_URL=http://192.168.0.202:9528
SECURITY_AUTHENTICATION_HTZH_MODE=jwt
SECURITY_AUTHENTICATION_HTZH_ORGCODE=tjsjpt
SECURITY_AUTHENTICATION_HTZH_BASEURL=http://172.30.30.1:15207

DEPENDS_SOFT_HOME=/product/services/soft
SEATUNNEL_HOME=/opt/soft/seatunnel
DAM_BASE_URL=http://192.168.0.202:9528