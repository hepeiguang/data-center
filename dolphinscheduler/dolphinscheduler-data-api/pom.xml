<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Detached from the DolphinScheduler reactor on purpose (docs/DATA-API-BOOT3-CONSOLE-PLAN.md D1/D2):
      DS 3.4.3 is Spring Boot 2.x / javax / Java 8 and cannot host a Boot 3 (Jakarta EE 9 / Spring 6)
      module in one fat jar. Directory and package names stay unchanged; only the parent is Boot.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.0.13</version>
        <relativePath/>
    </parent>

    <groupId>org.apache.dolphinscheduler</groupId>
    <artifactId>dolphinscheduler-data-api</artifactId>
    <version>3.4.3</version>
    <packaging>jar</packaging>
    <name>${project.artifactId}</name>
    <description>Data API microservice for DolphinScheduler (magic-api based SQL to HTTP + read-only query console)</description>

    <properties>
        <java.version>17</java.version>
        <magic-api.version>2.2.2</magic-api.version>
        <!-- DS BOM used to pin 2.2.220; Boot 3.0.13 defaults to 2.1.214 which cannot open existing dsdb files -->
        <h2.version>2.2.220</h2.version>
        <jsqlparser.version>4.6</jsqlparser.version>
        <!-- Boot 3.0 defaults the Servlet API to 6.0.0, but starter-jetty ships Jetty 11 (EE9):
             jetty-server 11.0.18 SessionHandler still links jakarta.servlet.http.HttpSessionContext,
             which was removed in 6.0.0 and blows up at web-server creation. Pin the EE9 line. -->
        <jakarta-servlet.version>5.0.0</jakarta-servlet.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-tomcat</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jetty</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <dependency>
            <groupId>org.ssssssss</groupId>
            <artifactId>magic-api-spring-boot-starter</artifactId>
            <version>${magic-api.version}</version>
            <exclusions>
                <!-- javax-based servlet bridge; keep magic-api-servlet-jakarta only -->
                <exclusion>
                    <groupId>org.ssssssss</groupId>
                    <artifactId>magic-api-servlet-javaee</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>
        <!-- metadata DB drivers (default profile: postgresql; h2 kept as offline fallback) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- self-built read-only access layer for t_ds_* metadata (replaces dolphinscheduler-dao) -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
        </dependency>
        <!-- console statement guard + lineage extraction -->
        <dependency>
            <groupId>com.github.jsqlparser</groupId>
            <artifactId>jsqlparser</artifactId>
            <version>${jsqlparser.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <mainClass>org.apache.dolphinscheduler.dataapi.DataApiServer</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
