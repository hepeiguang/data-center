<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.apache.dolphinscheduler.dao.mapper.ResourcesMapper">

    <!-- 公共字段 -->
    <sql id="baseSql">
        id, alias, file_name, description, user_id, type,
        size, create_time, update_time, pid, full_name, is_directory, custom_type, level, pfullName
    </sql>

    <!-- 插入资源（目录或者文件夹） -->
    <insert id="saveResource" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_ds_resources
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="alias != null">alias,</if>
            <if test="fileName != null">file_name,</if>
            <if test="description != null">description,</if>
            <if test="userId != null">user_id,</if>
            <if test="type != null">type,</if>
            <if test="size != null">size,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="pid != null">pid,</if>
            <if test="fullName != null">full_name,</if>
            <if test="isDirectory != null">is_directory,</if>
            <if test="customType != null">custom_type,</if>
            <if test="level!= null">level,</if>
            <if test="pfullName!= null">pfullName,</if>
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="alias != null">#{alias},</if>
            <if test="fileName != null">#{fileName},</if>
            <if test="description != null">#{description},</if>
            <if test="userId != null">#{userId},</if>
            <if test="type != null">#{type},</if>
            <if test="size != null">#{size},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="pid != null">#{pid},</if>
            <if test="fullName != null">#{fullName},</if>
            <if test="isDirectory != null">#{isDirectory},</if>
            <if test="customType != null">#{customType},</if>
            <if test="level!= null">#{level},</if>
            <if test="pfullName!= null">#{pfullName},</if>
        </trim>
    </insert>


    <update id="fixResourceByFullName">
        UPDATE t_ds_resources
        <set>
            <if test="fullName != null"> full_name = #{fullName}, </if>
            <if test="fileName != null">
                alias = #{fileName},
                file_name = #{fileName},
            </if>
            <if test="updateTime != null"> update_time = #{updateTime}, </if>
        </set>
        <if test="oldFullName != null">
            WHERE full_name = #{oldFullName}
        </if>
    </update>


    <delete id="delResourceByFullName">
        DELETE FROM t_ds_resources
        WHERE full_name = #{fullName}
    </delete>


    <select id="getResourceByFullName" resultType="org.apache.dolphinscheduler.dao.entity.Resources">
        SELECT *
        FROM t_ds_resources
        <where>
            <if test="fullName!= null and fullName.trim().length() > 0">
                full_name = #{fullName}
            </if>
        </where>
    </select>


    <select id="getResourceListLikePartName" resultType="org.apache.dolphinscheduler.dao.entity.Resources">
        SELECT
        <include refid="baseSql"/>
        FROM t_ds_resources
        WHERE full_name LIKE CONCAT(#{fullName}, '%') AND full_name != #{fullName}
    </select>


    <select id="getResourceListPaging" resultType="org.apache.dolphinscheduler.dao.entity.Resources">
        SELECT * FROM t_ds_resources WHERE 1=1
        <if test="fullName != null and fullName.trim().length() > 0">
            AND full_name LIKE CONCAT(#{fullName}, '%')
            AND full_name != #{fullName}
        </if>
        AND level = #{level}
        <if test="type != null">
            AND type = #{type}
        </if>
        <if test="customType != null and customType.trim().length() > 0">
            AND custom_type = #{customType}
        </if>
        <if test="searchVal != null and searchVal.trim().length() > 0">
            AND file_name LIKE CONCAT('%', #{searchVal}, '%')
        </if>
        ORDER BY create_time ASC
    </select>


    <select id="getAllResourceList" resultType="org.apache.dolphinscheduler.dao.entity.Resources">
        SELECT * FROM t_ds_resources
        <where>
            <if test="fullName!= null and fullName.trim().length() > 0">
                AND full_name LIKE CONCAT(#{fullName}, '%')
            </if>
        </where>
    </select>
    <select id="getResourceList" resultType="org.apache.dolphinscheduler.dao.entity.Resources">
        SELECT * FROM t_ds_resources
    </select>


</mapper>
